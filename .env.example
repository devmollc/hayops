# Copy to .env for local development. Every variable the app reads is listed here;
# blank means "unset" (the default in config/settings/base.py applies).

# --- Django ---
# Production: config.settings.production (the Docker image already sets this).
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Comma-separated. Production must list ADMIN_DOMAIN and every portal_domain.
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
# Production only, comma-separated, with scheme: https://helpdesk.example.com
CSRF_TRUSTED_ORIGINS=

# --- Database (docker-compose.yml maps Postgres to 5532) ---
DATABASE_NAME=helpdesk
DATABASE_USER=helpdesk
DATABASE_PASSWORD=helpdesk
DATABASE_HOST=localhost
DATABASE_PORT=5532

# --- Hosts ---
# Host that serves the staff UI. Any other host is matched against
# SourceApplication.portal_domain to serve that application's customer portal.
ADMIN_DOMAIN=localhost
# Absolute base URL used in emailed links.
SITE_URL=http://localhost:8000
# Request header holding the real client IP, as a request.META key, for rate
# limits. Blank = REMOTE_ADDR. Behind Cloudflare: HTTP_CF_CONNECTING_IP. Only set
# it when the app is unreachable except through that proxy.
CLIENT_IP_HEADER=

# --- Email ---
# Production uses SES regardless of this (config/settings/production.py).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_NAME=HayOps
DEFAULT_FROM_EMAIL=ticket@mail.example.com
# Reply-to domain for tickets whose application has no mail_domain.
DEFAULT_EMAIL_DOMAIN=mail.example.com
# Shared inbox alerted on new tickets and customer replies (blank = off).
SUPPORT_NOTIFY_EMAIL=
MAGIC_LINK_TTL_MINUTES=30
MAGIC_LINK_EMAIL_TTL_MINUTES=10080

# --- Cloudflare R2: media storage (production only) ---
# R2_* names only: an R2 key on an AWS_* name gets picked up by django-ses.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket for branding logos, and its public hostname (no scheme).
R2_MEDIA_BUCKET_NAME=
R2_PUBLIC_HOST=
# Private bucket for ticket attachments. Never make it public.
R2_STORAGE_BUCKET_NAME=

# --- AWS SES: outbound mail and inbound S3 (production only) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION_NAME=us-east-1
# Without a configuration set SES records no bounces, complaints or deliveries.
AWS_SES_CONFIGURATION_SET=
SES_AWS_REGION=us-east-1
SES_INBOUND_BUCKET=
SES_INBOUND_TOPIC_ARN=

# --- Optional ---
# Umami analytics on portal KB pages (blank = off). Website ID is per application.
UMAMI_HOST=
# Slug of the SourceApplication used by the helpdesk's own built-in widget.
HELPDESK_WIDGET_SLUG=helpdesk

# --- `just ses-setup` / `just ses-status` only ---
CLOUDFLARE_API_TOKEN=
HELPDESK_CNAME_TARGET=helpdesk.example.com
